*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  CASE ok_code.
    WHEN 'BACK'.
      LEAVE TO SCREEN 0.
    WHEN 'SAVE'.

      IF gt_final1 IS NOT INITIAL.
        DATA lv_ans TYPE char1.
        CLEAR lv_ans.
        CALL FUNCTION 'POPUP_TO_CONFIRM_STEP'
          EXPORTING
            defaultoption  = 'Y'
            textline1      = ''
            textline2      = 'Do you want to proceed...?'
            titel          = 'Confirm'
            start_column   = 25
            start_row      = 6
            cancel_display = ' '
          IMPORTING
            answer         = lv_ans.

        IF lv_ans = 'J'.
          LOOP AT gt_final_temp INTO DATA(gs_temp).
            DATA(lv_tabix) = sy-tabix.
            READ TABLE gt_final1 INTO gs_final1 INDEX lv_tabix.
            IF sy-subrc EQ 0.
              IF gs_temp NE gs_final1.

                gs_table = CORRESPONDING #( gs_final1 ).
                APPEND gs_table TO gt_table.
                CLEAR: gs_final1, gs_table.
              ENDIF.
            ENDIF.
          ENDLOOP.
          IF  gt_table IS NOT INITIAL.
            MODIFY zmm_pur_amend FROM TABLE gt_table.
            IF sy-subrc = 0.
