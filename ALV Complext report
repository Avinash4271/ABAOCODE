CLASS lcl_event_receiver DEFINITION.

  PUBLIC SECTION.

    METHODS : handle_data_changed
      FOR EVENT data_changed OF cl_gui_alv_grid
      IMPORTING er_data_changed.

  PRIVATE SECTION.

    DATA: error_in_data TYPE c.

    METHODS : check_menge_data
      IMPORTING
        ps_good         TYPE lvc_s_modi
        pr_data_changed TYPE REF TO cl_alv_changed_data_protocol.

    METHODS : check_data
      IMPORTING
        ps_good         TYPE lvc_s_modi
        pr_data_changed TYPE REF TO cl_alv_changed_data_protocol.

ENDCLASS.
CLASS lcl_event_receiver IMPLEMENTATION.
  METHOD handle_data_changed.
    DATA: ls_good TYPE lvc_s_modi.
    DATA: lv_row    TYPE i,
          lv_column TYPE i,
          lv_row_id TYPE lvc_s_row,
          lv_col_id TYPE lvc_s_col,
          lv_row_no TYPE lvc_s_roid,
          ls_stable TYPE lvc_s_stbl.
    error_in_data = space.

    g_grid->get_current_cell(
      IMPORTING
        e_row     = lv_row              " Row on Grid
*       e_value   = lv_column             " Value
        e_col     = lv_column             " Column on Grid
        es_row_id = lv_row_id              " Row ID
        es_col_id = lv_col_id            " Column ID
        es_row_no = lv_row_no            " Numeric Row ID
    ).
    LOOP AT er_data_changed->mt_good_cells INTO ls_good.
      CASE ls_good-fieldname.
        WHEN 'AIMP'.
          gv_aimp = ls_good-value.
        WHEN 'MENGE'.
          gv_menge = ls_good-value.
        WHEN 'DISC'.
          gv_disc = ls_good-value.
      ENDCASE.
      AT END OF row_id.
        READ TABLE gt_final1 ASSIGNING FIELD-SYMBOL(<gfs_final>) INDEX ls_good-row_id.
        IF sy-subrc = 0.
          IF gv_aimp IS NOT INITIAL AND gv_disc IS NOT INITIAL.
            <gfs_final>-netp = gv_aimp - (  gv_disc / 100 * gv_aimp ).
          ELSEIF gv_aimp IS INITIAL AND gv_disc IS NOT INITIAL.
            <gfs_final>-netp = <gfs_final>-aimp - (  gv_disc / 100 * <gfs_final>-aimp  ).
          ELSEIF gv_aimp IS NOT INITIAL AND gv_disc IS INITIAL.
            <gfs_final>-netp = gv_aimp - (  <gfs_final>-disc / 100 * gv_aimp  ).
          ENDIF.

          <gfs_final>-diff = <gfs_final>-netp - <gfs_final>-kbetr.
          IF gv_menge IS NOT INITIAL.
            <gfs_final>-tot_p = <gfs_final>-diff * gv_menge.
          ELSEIF gv_menge IS INITIAL.
            <gfs_final>-tot_p = <gfs_final>-diff * <gfs_final>-menge.
          ENDIF.
          CLEAR : gv_menge, gv_aimp, gv_disc.
        ENDIF.
      ENDAT.
    ENDLOOP.
    ls_stable-row = 'X'.
    ls_stable-col = 'X'.
    CALL METHOD g_grid->refresh_table_display(
        is_stable = ls_stable ).
    g_grid->set_current_cell_via_id(
      EXPORTING
        is_row_id    = lv_row_id                   " Row
        is_column_id = lv_col_id                 " Column
        is_row_no    = lv_row_no             " Numeric Row ID
    ).
  ENDMETHOD.
  METHOD check_menge_data.

  ENDMETHOD.
  METHOD check_data.
  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.
  IF p_date IS NOT INITIAL.
    p_date = p_date - 1.
  ENDIF.
  gv_date = '20170625'.
  PERFORM get_data.
FORM get_data.


  SELECT * FROM a016
               WHERE kschl = 'PI00'
               AND   evrtn LIKE  '19%'
               AND   datab LT @p_date
               AND   datab GT @gv_date
  INTO TABLE @DATA(gt_a016).

  SORT gt_a016 BY evrtn evrtp datab DESCENDING datbi DESCENDING.
  DELETE ADJACENT DUPLICATES FROM gt_a016 COMPARING evrtn evrtp.

  SELECT FROM @gt_a016 AS a
                   INNER JOIN konp AS k
                    ON k~knumh = a~knumh
                    AND k~kschl = 'PI00'
                     LEFT JOIN konp AS k1
                    ON k1~knumh = k~knumh
                    AND k~kschl = 'R005'
                    LEFT JOIN ekpo AS e
                    ON e~ebeln = a~evrtn
                    AND e~ebelp = a~evrtp
                    AND e~loekz NE 'X'
                    LEFT JOIN makt AS m
                    ON m~matnr = e~matnr
                    AND m~spras = 'E'
                    LEFT JOIN ekko AS ek
                    ON ek~ebeln = a~evrtn
                    INNER JOIN lfa1 AS l
                    ON l~lifnr = ek~lifnr
                    LEFT JOIN ztp_vend_bom  AS z
                    ON z~werks = e~werks
                    AND z~idnrk = m~matnr
                    LEFT JOIN ztb2b_base_grp AS z1
                    ON z1~bgrpn = z~bgrpn
      FIELDS DISTINCT e~bukrs,e~werks,e~ebeln,e~ebelp,k~knumh, ek~lifnr,l~name1,
                      e~matnr,m~maktx,z~bgrpn,z1~bgrpt,z~bmatnr,z~brgew, a~datab, a~datbi,k~kbetr, k~meins,
                      CAST( division( k1~kbetr , 100 , 1 ) AS DEC( 11,2 ) ) AS kbetr1,
                      CAST( (  k~kbetr - ( k~kbetr * division( k1~kbetr , 100 , 1 )  ) ) AS DEC( 11,2 )  ) AS rate
              WHERE  e~matnr IN @s_matnr
               AND   ek~lifnr IN @s_lifnr
               AND   e~werks IN @s_werks
               AND   z~bgrpn IN @s_grp
               AND   e~bukrs = @p_bukrs
  INTO TABLE @DATA(gt_final).


  SELECT * FROM zmm_pur_amend INTO TABLE @DATA(gt_amend)
    WHERE bukrs = @p_bukrs
    AND   werks IN @s_werks
  AND  matnr IN @s_matnr.

  IF gt_final IS NOT INITIAL.

    SELECT FROM mseg AS m
           INNER JOIN @gt_final AS g
           ON m~werks = g~werks
           AND m~matnr = g~matnr
           AND m~ebeln = g~ebeln
           AND m~ebelp = g~ebelp
           AND m~budat_mkpf GE g~datab
           AND m~budat_mkpf LE g~datbi
           AND m~bwart IN ( '101','102','122','123' )
           FIELDS m~werks,m~matnr, m~ebeln , m~ebelp,
           SUM( CASE
                   WHEN bwart = '101' THEN menge
                   WHEN bwart = '122' THEN -menge
                   WHEN bwart = '102' THEN -menge
                   WHEN bwart = '123' THEN menge
                   ELSE 0
                END ) AS qty
                GROUP BY m~werks, m~matnr, m~ebeln, m~ebelp
    INTO TABLE @DATA(gt_mseg).

  ENDIF.

  LOOP AT gt_final INTO DATA(gs_final).

    READ TABLE gt_amend INTO DATA(gs_amend) WITH KEY werks = gs_final-werks
                                                     matnr = gs_final-matnr
                                                     ebeln = gs_final-ebeln
                                                     ebelp = gs_final-ebelp
                                                     lifnr = gs_final-lifnr
                                                     datbi = gs_final-datbi.
    IF sy-subrc = 0.

      gs_final1 = CORRESPONDING #( gs_amend ).
      SELECT SINGLE maktx INTO @gs_final1-maktx FROM makt WHERE matnr = @gs_final1-matnr AND spras = 'E'.
      SELECT SINGLE name1 INTO @gs_final1-name1 FROM lfa1 WHERE lifnr = @gs_final1-lifnr.

    ELSE.
      READ TABLE gt_mseg INTO DATA(gs_mseg) WITH KEY werks = gs_final-werks
                                                     matnr = gs_final-matnr
                                                     ebeln = gs_final-ebeln
                                                     ebelp = gs_final-ebelp.
      IF sy-subrc = 0.

        gs_final1 = CORRESPONDING #( gs_final ).
        gs_final1-rate = gs_final1-kbetr - ( gs_final1-kbetr * gs_final1-kbetr1 ).
        gs_final1-menge = gs_mseg-qty.
        gs_final1-disc = gs_final-kbetr1.

      ENDIF.

    ENDIF.
    IF gs_final1 IS NOT INITIAL.
      IF gs_final1-aimp IS NOT INITIAL.
        ls_styl-fieldname = 'AIMP'.
        ls_styl-style     = cl_gui_alv_grid=>mc_style_disabled.
        APPEND ls_styl TO gs_final1-field_style.
        ls_styl-fieldname = 'DISC'.
        ls_styl-style     = cl_gui_alv_grid=>mc_style_disabled.
        APPEND ls_styl TO gs_final1-field_style.
      ENDIF.
*      IF gs_final1-disc IS NOT INITIAL.
*        ls_styl-fieldname = 'DISC'.
*        ls_styl-style     = cl_gui_alv_grid=>mc_style_disabled.
*        APPEND ls_styl TO gs_final1-field_style.
*      ENDIF.
      APPEND gs_final1 TO gt_final1.
    ENDIF.
    CLEAR : gs_final1,gs_final,gs_mseg,gs_amend.


  ENDLOOP.

  gt_final_temp = gt_final1.
  CALL SCREEN '0100'.

ENDFORM.

