*&--------------------------------------------------------------------*
*PROGRAM.......ZPP_QM_LOT_SINGLE                                      *
*T-CODE........ZQM105                                                 *
*TITLE......... DOL Master maintenance at plant level                 *
*AUTHOR........ Avinash Devkar                                        *
*FUNCTIONAL.... Anil Bhandurage                                       *
*DATE WRITTEN.. 10, 07 2026                                           *
*R/3 RELEASE... E.C.C 6.0                                             *
*&--------------------------------------------------------------------*
*&---------------------------------------------------------------------*
REPORT zpp_qm_lot_single.

TABLES: zqm_lot.

DATA:
  gt_sellist TYPE STANDARD TABLE OF vimsellist.

DATA:
  gt_werks TYPE RANGE OF zqm_lot-werks,
  gt_lifnr TYPE RANGE OF zqm_lot-lifnr.
PARAMETERS:
  p_werks TYPE zqm_lot-werks OBLIGATORY,
  p_lifnr TYPE zqm_lot-lifnr OBLIGATORY.



AT SELECTION-SCREEN.

  SELECT SINGLE * FROM zqm_lot_user WHERE werks = @p_werks AND uname = @sy-uname INTO @DATA(ls_usr).
  IF sy-subrc NE 0.
    MESSAGE 'No Authorization For Given Plant....' TYPE 'E'.
  ENDIF.

START-OF-SELECTION.

  "------------------------------------------------------------
  " Create Plant range
  "------------------------------------------------------------
  APPEND VALUE #(
    sign   = 'I'
    option = 'EQ'
    low    = p_werks
  ) TO gt_werks.

  "------------------------------------------------------------
  " Create Material range
  "------------------------------------------------------------
  APPEND VALUE #(
    sign   = 'I'
    option = 'EQ'
    low    = p_lifnr
  ) TO gt_lifnr.

  "------------------------------------------------------------
  " Convert Plant range to TMG selection condition
  "------------------------------------------------------------
  CALL FUNCTION 'VIEW_RANGETAB_TO_SELLIST'
    EXPORTING
      fieldname          = 'WERKS'
      append_conjunction = 'AND'
    TABLES
      sellist            = gt_sellist
      rangetab           = gt_werks
    EXCEPTIONS
      OTHERS             = 1.

  IF sy-subrc <> 0.
    MESSAGE 'Error creating Plant selection condition' TYPE 'E'.
  ENDIF.

  "------------------------------------------------------------
  " Convert Material range to TMG selection condition
  "------------------------------------------------------------
  CALL FUNCTION 'VIEW_RANGETAB_TO_SELLIST'
    EXPORTING
      fieldname          = 'LIFNR'
      append_conjunction = 'AND'
    TABLES
      sellist            = gt_sellist
      rangetab           = gt_LIFNR
    EXCEPTIONS
      OTHERS             = 1.

  IF sy-subrc <> 0.
    MESSAGE 'Error creating Material selection condition' TYPE 'E'.
  ENDIF.


  "--------------------------------------------------
  " Call TMG
  "--------------------------------------------------
  CALL FUNCTION 'VIEW_MAINTENANCE_CALL'
    EXPORTING
      action                       = 'U'
      view_name                    = 'ZQM_LOT'
    TABLES
      dba_sellist                  = gt_sellist
    EXCEPTIONS
      client_reference             = 1
      foreign_lock                 = 2
      invalid_action               = 3
      no_clientindependent_auth    = 4
      no_show_auth                 = 5
      no_tvdir_entry               = 6
      no_upd_auth                  = 7
      only_show_allowed            = 8
      system_failure               = 9
      unknown_field_in_dba_sellist = 10
      missing_corr_number          = 11
      OTHERS                       = 12.

  IF sy-subrc <> 0.
    MESSAGE 'DATA is not found' TYPE 'E'.
  ENDIF.


