CLASS ZCL_ZSD_QRCODE_STICKER_DPC_EXT IMPLEMENTATION.


  METHOD /iwbep/if_mgw_appl_srv_runtime~get_stream.


    TYPES : BEGIN OF gty_tab,
              sr      TYPE i,
              kdmat_1 TYPE kdmat,
              maktx_1 TYPE char20,
              model_1 TYPE char25,
              cn_1    TYPE i,
              kdmat_2 TYPE kdmat,
              maktx_2 TYPE char20,
              model_2 TYPE char25,
              cn_2    TYPE i,
            END OF gty_tab.
    DATA : gt_tab TYPE STANDARD TABLE OF gty_tab,
           gw_tab TYPE gty_tab..
    DATA(it_keys) = io_tech_request_context->get_keys( ).
    DATA(lv_key) = VALUE #( it_keys[ 1 ]-value OPTIONAL ).
    DATA : gw_hdr TYPE zcl_zsd_qrcode_sticker_mpc=>ts_et_print.
    DATA lo_cotainer TYPE REF TO /iwbep/if_message_container.

    DATA :
      lv_fm_name            TYPE rs38l_fnam,
      lv_labno              TYPE zlabno,
      lv_matnr              TYPE matnr,
      lv_kunnr              TYPE kunnr,
      lv_pkgno              TYPE zpkgno,
      lv_kdmat              TYPE kdmat,
      ls_output_options     TYPE ssfcompop,
      lv_language           TYPE tdspras,
      ls_control_parameters TYPE ssfctrlop,
      ls_output_data        TYPE ssfcrescl,
      lv_pdf_len            TYPE i,
      lv_pdf_xstring        TYPE xstring,
      lt_lines              TYPE TABLE OF tline,
      lv_devtype            TYPE rspoptype,
      lv_app_type           TYPE string,
      lv_guid               TYPE guid_32,
      lo_cached_response    TYPE REF TO if_http_response,
      lt_tstotf             TYPE tsfotf,
      ls_job_output_info    TYPE ssfcrescl.

    READ TABLE it_keys WITH KEY name = 'WERKS' INTO DATA(ls_key).
    gw_hdr-werks = ls_key-value.
    READ TABLE it_keys WITH KEY name = 'VKORG' INTO DATA(ls_key1).
    gw_hdr-vkorg = ls_key1-value.
    READ TABLE it_keys WITH KEY name = 'VTWEG' INTO DATA(ls_key2).
    gw_hdr-vtweg = ls_key2-value.
    READ TABLE it_keys WITH KEY name = 'KUNNR' INTO DATA(ls_key3).
    gw_hdr-kunnr = ls_key3-value.
    READ TABLE it_keys WITH KEY name = 'KDMAT' INTO DATA(ls_key4).
    gw_hdr-kdmat = ls_key4-value.
    READ TABLE it_keys WITH KEY name = 'MATNR' INTO DATA(ls_key5).
    gw_hdr-matnr = ls_key5-value.
    READ TABLE it_keys WITH KEY name = 'MODEL' INTO DATA(ls_key6).
    gw_hdr-model = ls_key6-value.
    READ TABLE it_keys WITH KEY name = 'STICK' INTO DATA(ls_key7).
    gw_hdr-stick = ls_key7-value.
    READ TABLE it_keys WITH KEY name = 'PRINT' INTO DATA(ls_key8).
    gw_hdr-print = ls_key8-value.
    lo_cotainer = me->mo_context->get_message_container( ).
    IF gw_hdr-werks IS NOT INITIAL.
      SELECT SINGLE werks FROM t001w WHERE werks =  @gw_hdr-werks
        INTO @DATA(ls_werks).
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Invalid plant code.'
            iv_add_to_response_header = abap_true.
        EXIT.
      ENDIF.
    ENDIF.

    SELECT SINGLE maktx FROM makt INTO @DATA(gw_maktx)
      WHERE matnr = @gw_hdr-matnr
      AND   spras = @sy-langu.
    IF sy-subrc NE 0.
      CALL METHOD lo_cotainer->add_message
        EXPORTING
          iv_msg_type               = /iwbep/cl_cos_logger=>error
          iv_msg_id                 = '00'
          iv_msg_number             = '000'
          iv_msg_text               = 'Invalid Material code.'
          iv_add_to_response_header = abap_true.
      EXIT.
    ENDIF.
    lv_kunnr = gw_hdr-kunnr.
    lv_kunnr = |{ lv_kunnr ALPHA = IN }|.
    gw_hdr-kunnr = lv_kunnr.
    IF NOT gw_hdr-kunnr IS INITIAL.
      SELECT SINGLE name1 FROM kna1 INTO @DATA(lv_name)
        WHERE kunnr = @gw_hdr-kunnr.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Invalid Customer code.'
            iv_add_to_response_header = abap_true.

        EXIT.
      ENDIF.
    ENDIF.

    SELECT padest, paprosname AS pname FROM tsp03d INTO TABLE @DATA(lt_dest)
WHERE padest IN ('ZM4','ZM5','ZM6').
    READ TABLE lt_dest INTO DATA(ls_dest) WITH KEY padest = gw_hdr-print.
    IF sy-subrc NE 0.
      CALL METHOD lo_cotainer->add_message
        EXPORTING
          iv_msg_type               = /iwbep/cl_cos_logger=>error
          iv_msg_id                 = '00'
          iv_msg_number             = '000'
          iv_msg_text               = 'Invalid Printer...'
          iv_add_to_response_header = abap_true.

      EXIT.
    ENDIF.

    IF lv_key IS NOT INITIAL.

* language
      lv_language = sy-langu.

      TRANSLATE lv_language TO UPPER CASE.
      ls_control_parameters-langu = lv_language.

* set control parameters to get the output text format (OTF) from Smart Forms
      ls_control_parameters-no_dialog = abap_true.
      ls_control_parameters-getotf    = abap_true.
      ls_control_parameters-preview = space. "No preview


* get device type from language
      CALL FUNCTION 'SSF_GET_DEVICE_TYPE'
        EXPORTING
          i_language             = lv_language
        IMPORTING
          e_devtype              = lv_devtype
        EXCEPTIONS
          no_language            = 1
          language_not_installed = 2
          no_devtype_found       = 3
          system_error           = 4
          OTHERS                 = 5.

* set device type in output options
      ls_output_options-tdprinter = lv_devtype.
* Set relevant output options
      ls_output_options-tdnewid  = 'X'. "Print parameters,
      ls_output_options-tddelete = space. "Print parameters
      ls_output_options-tddest = gw_hdr-print.


      DATA : lf_fm_name TYPE rs38l_fnam..
      CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
        EXPORTING
*         formname           = 'ZSD_BAL_QR_FORM'
          formname           = 'ZSD_BAL_QR_FORM_FIORI'
*         VARIANT            = ' '
*         DIRECT_CALL        = ' '
        IMPORTING
          fm_name            = lf_fm_name
        EXCEPTIONS
          no_form            = 1
          no_function_module = 2
          OTHERS             = 3.
      IF sy-subrc <> 0.

      ENDIF.



      DATA cn TYPE zsd_bal_stic-cn.
      SELECT SINGLE * FROM zsd_bal_stic INTO @DATA(ls_tab)
        WHERE werks = @gw_hdr-werks
        AND   kunnr = @gw_hdr-kunnr
        AND   matnr = @gw_hdr-matnr.
      IF sy-subrc = 0.
        cn = ls_tab-cn.
        IF cn = '999999'.
          cn = '1'.
        ELSE.
          cn = cn + 1.
        ENDIF.
        IF cn IS INITIAL.
          cn = '1'.
        ENDIF.
      ELSE.
        cn = 1.
      ENDIF.


      REFRESH gt_tab.
      DATA ctr TYPE i.
      DO gw_hdr-stick TIMES.
        ctr = ctr + 1.
        gw_tab-sr = ctr.
        gw_tab-kdmat_1 = gw_hdr-kdmat.
        gw_tab-maktx_1 = gw_maktx.
        gw_tab-model_1 = gw_hdr-model.
        gw_tab-cn_1    = cn.

        APPEND gw_tab TO gt_tab.
        IF ctr = gw_hdr-stick OR gw_hdr-stick < ctr.
          EXIT.
        ENDIF.

        IF cn = '999999'.
          cn = 0.
        ENDIF.

        cn = cn + 1.
        CLEAR gw_tab.
      ENDDO.
      EXPORT gt_tab = gt_tab TO MEMORY ID 'ZSD_BAL_QRCODE_PRINT'.

      CALL FUNCTION lf_fm_name
        EXPORTING
          control_parameters = ls_control_parameters
          output_options     = ls_output_options
          user_settings      = ' '
        IMPORTING
          job_output_info    = ls_job_output_info
        EXCEPTIONS
          formatting_error   = 1
          internal_error     = 2
          send_error         = 3
          user_canceled      = 4
          OTHERS             = 5.
      IF sy-subrc <> 0.
      ENDIF.

      APPEND LINES OF ls_job_output_info-otfdata[] TO lt_tstotf[].

* convert to otf
      CALL FUNCTION 'CONVERT_OTF'
        EXPORTING
          format                = 'PDF'
        IMPORTING
          bin_filesize          = lv_pdf_len
          bin_file              = lv_pdf_xstring       " binary file
        TABLES
          otf                   = lt_tstotf
          lines                 = lt_lines
        EXCEPTIONS
          err_max_linewidth     = 1
          err_format            = 2
          err_conv_not_possible = 3
          err_bad_otf           = 4
          OTHERS                = 5.
      IF sy-subrc <> 0.


      ENDIF.


      ls_tab-werks = gw_hdr-werks.
      ls_tab-kunnr = gw_hdr-kunnr.
      ls_tab-matnr = gw_hdr-matnr.
      ls_tab-cn = cn.
      MODIFY zsd_bal_stic FROM ls_tab.



      DATA(ls_s_media_resource) = VALUE ty_s_media_resource( mime_type = 'application/pdf'
                                                             value     = lv_pdf_xstring ).

      copy_data_to_ref(
        EXPORTING
          is_data = ls_s_media_resource
        CHANGING
          cr_data = er_stream
      ).
    ENDIF.
  ENDMETHOD.


  METHOD et_customerset_get_entityset.
    SELECT kunnr , name1 AS kname FROM kna1 INTO TABLE @et_entityset.
  ENDMETHOD.


  METHOD et_pdestset_get_entityset.
    SELECT padest, paprosname AS pname FROM tsp03d INTO TABLE @et_entityset
    WHERE padest IN ('ZM4','ZM5','ZM6').
  ENDMETHOD.


  method ET_PLANTSET_GET_ENTITYSET.

    SELECT werks , name1 as wname from t001w INTO TABLE @et_entityset.
  endmethod.


  METHOD et_scanset_create_entity.
    TYPES : BEGIN OF gty_tab,
              sr      TYPE i,
              kdmat_1 TYPE kdmat,
              maktx_1 TYPE char20,
              model_1 TYPE char25,
              cn_1    TYPE i,
              kdmat_2 TYPE kdmat,
              maktx_2 TYPE char20,
              model_2 TYPE char25,
              cn_2    TYPE i,
            END OF gty_tab.

*- Internal table declaration
    DATA : gt_tab TYPE STANDARD TABLE OF gty_tab,
           gw_tab TYPE gty_tab.
    DATA : gw_control  TYPE ssfctrlop,
           gw_output   TYPE ssfcompop,
           uflag(1)    TYPE c,
           lv_language TYPE tdspras,
           lv_devtype  TYPE rspoptype.
    DATA : gw_hdr TYPE zsd_bal_str.
    CONSTANTS : c_form     TYPE tdsfname VALUE 'ZSD_BAL_QR_FORM',
*    CONSTANTS : c_form     TYPE tdsfname VALUE 'ZSD_BAL_QR_FORM_FIORI',
                c_memoryid TYPE sy-repid VALUE 'ZSD_BAL_QRCODE_PRINT'.
    DATA : gw_data TYPE zcl_zsd_qrcode_sticker_mpc=>ts_et_scan.
    DATA lo_cotainer TYPE REF TO /iwbep/if_message_container.

    TRY.

        io_data_provider->read_entry_data(
          IMPORTING
            es_data = gw_data
        ).
      CATCH /iwbep/cx_mgw_tech_exception. " mgw technical exception

    ENDTRY.
    lo_cotainer = me->mo_context->get_message_container( ).


    IF gw_data IS NOT INITIAL.

      gw_output-tdcovtitle  = 'QRCode Printing FG Traceability'.
      gw_output-tdreceiver  = sy-uname.
      gw_output-tdcopies    = '1'.


      gw_output-tddest      = gw_data-print.
      gw_output-xsfoutdev   = gw_data-print.

      gw_output-tdimmed     = 'X'.
      gw_output-tddelete    = ' '.
      gw_output-tdnoprint   = ' '.  " No printing from print preview

      gw_output-tdarmod = '1'.   "print only
      gw_output-tdnewid = 'X'.   "spool


*--------- CONTROL :
      gw_control-device     = 'PRINTER'.  " Output on a printer
      gw_control-no_dialog  = abap_true.        " No Popup
      gw_control-preview    = ''.
      gw_control-getotf     = abap_true.

      gw_control-langu      = sy-langu.
      lv_language   = sy-langu.

      CALL FUNCTION 'SSF_GET_DEVICE_TYPE'
        EXPORTING
          i_language             = lv_language
*         i_application          = 'SAPDEFAULT'
        IMPORTING
          e_devtype              = lv_devtype
        EXCEPTIONS
          no_language            = 1
          language_not_installed = 2
          no_devtype_found       = 3
          system_error           = 4
          OTHERS                 = 5.

      gw_output-tdprinter = lv_devtype.


      DATA : lf_fm_name TYPE rs38l_fnam..
      CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
        EXPORTING
          formname           = c_form
*         VARIANT            = ' '
*         DIRECT_CALL        = ' '
        IMPORTING
          fm_name            = lf_fm_name
        EXCEPTIONS
          no_form            = 1
          no_function_module = 2
          OTHERS             = 3.
      IF sy-subrc <> 0.
* Implement suitable error handling here
      ENDIF.

      gw_hdr = CORRESPONDING #( gw_data ).

      IF gw_hdr-werks IS NOT INITIAL.
        SELECT SINGLE werks FROM t001w WHERE werks =  @gw_hdr-werks
          INTO @DATA(ls_werks).
        IF sy-subrc NE 0.
          CALL METHOD lo_cotainer->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Invalid plant code.'
              iv_add_to_response_header = abap_true.
          er_entity-scan = 'error'.
          EXIT.
        ENDIF.
      ENDIF.
      SELECT padest, paprosname AS pname FROM tsp03d INTO TABLE @DATA(lt_dest)
      WHERE padest IN ('ZM4','ZM5','ZM6').
      READ TABLE lt_dest INTO DATA(ls_dest) WITH KEY padest = gw_data-print.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Invalid Printer...'
            iv_add_to_response_header = abap_true.

        EXIT.
      ENDIF.
      SELECT SINGLE maktx FROM makt INTO gw_hdr-maktx
        WHERE matnr = gw_hdr-matnr
        AND   spras = sy-langu.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Invalid Material code.'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'error'.
        EXIT.
      ENDIF.
      gw_hdr-kunnr = |{ gw_hdr-kunnr  ALPHA = IN }|.
      IF NOT gw_hdr-kunnr IS INITIAL.
        SELECT SINGLE name1 FROM kna1 INTO gw_hdr-name1
          WHERE kunnr = gw_hdr-kunnr.
        IF sy-subrc NE 0.
          CALL METHOD lo_cotainer->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Invalid Customer code code.'
              iv_add_to_response_header = abap_true.
          er_entity-scan = 'error'.
          EXIT.
        ENDIF.
      ENDIF.

      gw_hdr-menge = gw_data-stick.

      DATA cn TYPE zsd_bal_stic-cn.
      SELECT SINGLE * FROM zsd_bal_stic INTO @DATA(ls_tab)
        WHERE werks = @gw_hdr-werks
        AND   kunnr = @gw_hdr-kunnr
        AND   matnr = @gw_hdr-matnr.
      IF sy-subrc = 0.
        cn = ls_tab-cn.
        IF cn = '999999'.
          cn = '1'.
        ELSE.
          cn = cn + 1.
        ENDIF.
        IF cn IS INITIAL.
          cn = '1'.
        ENDIF.
      ELSE.
        cn = 1.
      ENDIF.


      DATA ctr TYPE i.
      DO gw_hdr-menge TIMES.
        ctr = ctr + 1.
        gw_tab-sr = ctr.
        gw_tab-kdmat_1 = gw_hdr-kdmat.
        gw_tab-maktx_1 = gw_hdr-maktx.
        gw_tab-model_1 = gw_hdr-model.
        gw_tab-cn_1    = cn.

        APPEND gw_tab TO gt_tab.
        IF ctr = gw_hdr-menge OR gw_hdr-menge < ctr.
          EXIT.
        ENDIF.

        IF cn = '999999'.
          cn = 0.
        ENDIF.

        cn = cn + 1.
        CLEAR gw_tab.
      ENDDO.

      EXPORT gt_tab = gt_tab TO MEMORY ID 'ZSD_BAL_QRCODE_PRINT'.

      CALL FUNCTION lf_fm_name
        EXPORTING
          control_parameters = gw_control
          output_options     = gw_output
          user_settings      = ' '
        EXCEPTIONS
          formatting_error   = 1
          internal_error     = 2
          send_error         = 3
          user_canceled      = 4
          OTHERS             = 5.
      IF sy-subrc <> 0.
      ENDIF.



*      ls_tab-werks = gw_hdr-werks.
*      ls_tab-kunnr = gw_hdr-kunnr.
*      ls_tab-matnr = gw_hdr-matnr.
*      ls_tab-cn = cn.
*      MODIFY zsd_bal_stic FROM ls_tab.

      IF sy-subrc = 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>success
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Sticker send for printing...'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'success'.
      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD et_scanset_get_entity.
    DATA : gw_scandata(50) TYPE c.
    DATA : gw_hdr TYPE zsd_bal_str.

    DATA lo_cotainer TYPE REF TO /iwbep/if_message_container.

    READ TABLE it_key_tab INTO DATA(ls_data) WITH KEY name = 'SCAN'.
    IF sy-subrc = 0.
      gw_scandata = ls_data-value.
    ENDIF.
    READ TABLE it_key_tab INTO ls_data WITH KEY name = 'WERKS'.
    IF sy-subrc = 0.
      gw_hdr-werks = ls_data-value.
    ENDIF.
    READ TABLE it_key_tab INTO ls_data WITH KEY name = 'VKORG'.
    IF sy-subrc = 0.
      gw_hdr-vkorg = ls_data-value.
    ENDIF.
    READ TABLE it_key_tab INTO ls_data WITH KEY name = 'VTWEG'.
    IF sy-subrc = 0.
      gw_hdr-vtweg = ls_data-value.
    ENDIF.

    READ TABLE it_key_tab INTO ls_data WITH KEY name = 'KUNNR'.
    IF sy-subrc = 0.
      gw_hdr-kunnr = ls_data-value.
    ENDIF.
    gw_hdr-kunnr =  |{ gw_hdr-kunnr ALPHA = IN }|.

    lo_cotainer = me->mo_context->get_message_container( ).


    IF gw_scandata IS NOT INITIAL .
      SPLIT gw_scandata AT ';' INTO
         DATA(s_custmat) DATA(s_srno) DATA(s_vnd) DATA(s_loc) DATA(s_model) DATA(s_shift).

      IF s_custmat IS INITIAL OR
        s_srno IS INITIAL OR
        s_vnd IS INITIAL OR
        s_loc IS INITIAL OR
        s_model IS INITIAL OR
        s_shift IS INITIAL..
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Invalid QRCode....'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'error'.
        EXIT.
      ENDIF.

      CONDENSE : s_custmat, s_vnd.
      SELECT SINGLE vndrcd FROM ymslt_vndrno_map INTO @DATA(l_vnd)
        WHERE kunnr = @gw_hdr-kunnr
        AND   werks = @gw_hdr-werks.
      IF l_vnd NE s_vnd.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Part number does not match with ZSD05...'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'error'.
        EXIT.
      ENDIF.
      er_entity-kdmat = s_custmat.
      gw_hdr-kdmat = s_custmat.
      SELECT SINGLE matnr FROM knmt INTO er_entity-matnr
        WHERE vkorg = gw_hdr-vkorg
        AND   vtweg = gw_hdr-vtweg
        AND   kunnr = gw_hdr-kunnr
        AND   kdmat = gw_hdr-kdmat.

     gw_hdr-matnr =  er_entity-matnr.
*----------------------------------------------------

      SELECT SINGLE * FROM zsd_bal_stic INTO @DATA(ls_st)
        WHERE werks = @gw_hdr-werks
        AND   kunnr = @gw_hdr-kunnr
        AND   matnr = @gw_hdr-matnr.
      IF sy-subrc NE 0.

        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Pl maintain Material details in ZSD326...'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'error'.
        EXIT.
      ELSE.
        IF ls_st-model IS INITIAL.
*
          CALL METHOD lo_cotainer->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'please maintain MODEL name in ZSD326....'
              iv_add_to_response_header = abap_true.
          er_entity-scan = 'error'.
          EXIT.
        ELSE.
          er_entity-model = ls_st-model.
        ENDIF.
      ENDIF.
      CLEAR ls_st.

      SELECT SINGLE kdmat FROM knmt INTO er_entity-kdmat
       WHERE vkorg = gw_hdr-vkorg
       AND   vtweg = gw_hdr-vtweg
       AND   kunnr = gw_hdr-kunnr
       AND   matnr = gw_hdr-matnr.
      IF sy-subrc NE 0.

        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Customer-Material Info Record not found....'
            iv_add_to_response_header = abap_true.
        er_entity-scan = 'error'.
        EXIT.
      ELSE.
        IF er_entity-kdmat IS INITIAL.

          CALL METHOD lo_cotainer->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Customer material not maintained in InfoRecord.....'
              iv_add_to_response_header = abap_true.
          er_entity-scan = 'error'.
          EXIT.
        ENDIF.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD valid_data.
    DATA : ls_return TYPE bapiret2.

 IF gw_data-vkorg IS INITIAL.
     append VALUE #( type = 'E' message = 'Please enter SOrganisation...' ) to gt_return.
