          CLEAR mth.
          ls_dtl-werks = ls_hdr-werks.
          ls_dtl-matnr = ls_hdr-matnr.
          ls_dtl-srnos = str2.
          ls_dtl-pkgno = ls_hdr-pkgno.
          ls_dtl-dtcode = str3.
          ls_dtl-kunnr = ls_hdr-kunnr.
          DELETE ls_data_deep-scan WHERE kdmat = ''.

