  METHOD et_packageset_create_entity.
    DATA lv_kunnr TYPE kunnr.

    DATA : gs_entity TYPE zcl_zsd_cust_fg_mpc=>ts_et_package.
    TRY.
        CALL METHOD io_data_provider->read_entry_data
          IMPORTING
            es_data = gs_entity.
      CATCH /iwbep/cx_mgw_tech_exception.
    ENDTRY.
    lv_kunnr = gs_entity-kunnr.
    lv_kunnr = |{ lv_kunnr ALPHA = IN }|.
    DELETE FROM zsd_cust_fg_st WHERE matnr = gs_entity-matnr
        AND werks = gs_entity-werks
        AND  srnos = gs_entity-serial
        AND kunnr = lv_kunnr
        AND  mjahr = gs_entity-year.

    er_entity-no = gs_entity-no - 1.
    er_entity-matnr = 'S'.
    er_entity-maktx = 'Recored deleted succefully'.

  ENDMETHOD.


  METHOD et_packageset_delete_entity.
    DATA: ls_entityset    TYPE zsd_ford_fg_st,
          ls_key_tab      TYPE /iwbep/s_mgw_name_value_pair,
          lv_error_entity TYPE string,
          lv_matnr(18)    TYPE c,
          lv_werks        TYPE werks_d,
          lv_srnos        TYPE zsrno,
          lv_mjahr        TYPE mjahr,
          lv_kunnr        TYPE kunnr.

    LOOP AT it_key_tab INTO DATA(lwa_key_tab).
      CASE lwa_key_tab-name.
        WHEN 'MATNR'.
          lv_matnr = lwa_key_tab-value.
          lv_matnr =  |{ lv_matnr ALPHA = IN }|.

        WHEN 'MJAHR'.
          lv_mjahr = lwa_key_tab-value.
        WHEN 'SERIAL'.
          lv_srnos = lwa_key_tab-value.
        WHEN 'WERKS'.
          lv_werks = lwa_key_tab-value.
        WHEN 'KUNNR'.
          lv_kunnr = lwa_key_tab-value.
      ENDCASE.
    ENDLOOP.

    DELETE FROM zsd_cust_fg_st WHERE matnr = lv_matnr
    AND werks = lv_werks
    AND  srnos = lv_srnos
    AND kunnr = lv_kunnr
    AND  mjahr = lv_mjahr.

  ENDMETHOD.


