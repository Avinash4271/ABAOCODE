      lv_kunnr = ls_data_deep-kunnr.
      lv_kunnr = |{ lv_kunnr ALPHA = IN }|.

      IF ls_data_deep-kdmat = 'SUBMIT'.       "SUBMIT Button

        DATA   lv_labno    TYPE zsd_cust_fg_st-labno.
        CLEAR lv_labno.
        SELECT MAX( labno ) FROM zsd_cust_fg_st INTO lv_labno
          WHERE werks = ls_data_deep-werks
          AND   matnr = ls_data_deep-matnr
          AND   kunnr = lv_kunnr.

        IF ls_data_deep-srnos = 'C'. "for change

          lv_labno = ls_data_deep-labno.
        ELSE.
          IF lv_labno  IS INITIAL.
            lv_labno  = 1.
          ELSE.
            lv_labno  = lv_labno  + 1.
          ENDIF.
        ENDIF.
        IF NOT ls_data_deep-scan IS INITIAL.
          LOOP AT ls_data_deep-scan INTO DATA(ls_scan).
            SELECT SINGLE * FROM zsd_cust_fg_st WHERE werks = @ls_data_deep-werks
                                                  AND matnr = @ls_data_deep-matnr
                                                  AND kunnr = @lv_kunnr
                                                  AND srnos = @ls_scan-serial
                                                  AND labno = @lv_labno
                                                  AND kdmat = @ls_scan-kdmat
                                                INTO @DATA(ls_check).
            IF sy-subrc NE 0.
              gs_dtl-werks = ls_data_deep-werks.
              gs_dtl-matnr = ls_data_deep-matnr.
              gs_dtl-mjahr = ls_scan-year.
              IF gs_dtl-mjahr = '0000'.
                CLEAR : gs_dtl-mjahr.
              ENDIF.
              gs_dtl-srnos = ls_scan-serial.
              gs_dtl-sdate = ls_scan-date.
              IF gs_dtl-sdate = '00000000'.
                CLEAR : gs_dtl-sdate.
              ENDIF.
              gs_dtl-kunnr = lv_kunnr.
              TRANSLATE  ls_scan-kdmat TO UPPER CASE . "added Avinash : 19.12.2024 : ECDK932068
              gs_dtl-kdmat = ls_scan-kdmat.
              gs_dtl-pkgno = ls_data_deep-pkgno.
              gs_dtl-labno = lv_labno.
              gs_dtl-erdat = sy-datum.
              gs_dtl-ernam = sy-uname.
              gs_dtl-ertim = sy-uzeit.
              gs_dtl-dtcode = ls_scan-dtcode.
              gs_dtl-vndrcd = ls_scan-vndrcd. "added Avinash : 19.12.2024 : ECDK932068
              APPEND gs_dtl TO gt_dtl.
            ELSE.

            ENDIF.


            CLEAR : gs_dtl, ls_scan.
          ENDLOOP.

          lv_msg = | Outer Label Number generated... { lv_labno } |.

          MODIFY zsd_cust_fg_st FROM TABLE gt_dtl.
          COMMIT WORK.
          IF sy-subrc = 0.
            CALL METHOD lo_container->add_message
              EXPORTING
                iv_msg_type               = /iwbep/cl_cos_logger=>success
                iv_msg_id                 = '00'
                iv_msg_number             = '000'
                iv_msg_text               = lv_msg
                iv_add_to_response_header = abap_true.
            copy_data_to_ref( EXPORTING is_data = ls_data_deep
                              CHANGING  cr_data = er_deep_entity ).
            EXIT.
          ENDIF.
        ENDIF.
      ELSE.
        IF ls_data_deep-maktx IS NOT INITIAL. "scan string in maktx
          DATA(lv_str1) = ls_data_deep-maktx.

          DATA : mth(2) TYPE c,
                 yer(2) TYPE c.

          DATA lv_date(10) TYPE c.
          SPLIT lv_str1 AT '-' INTO DATA(str1) DATA(str2) DATA(str3) DATA(str4).
          CONDENSE : str1, str2, str3, str4.

          SELECT SINGLE * FROM zsd_cust_fg_pk INTO @DATA(ls_hdr)
