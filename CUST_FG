            WHEN 'B'. mth = '02'.
            WHEN 'C'. mth = '03'.
            WHEN 'D'. mth = '04'.
            WHEN 'E'. mth = '05'.
            WHEN 'F'. mth = '06'.
            WHEN 'G'. mth = '07'.
            WHEN 'H'. mth = '08'.
            WHEN 'I'. mth = '09'.
            WHEN 'J'. mth = '10'.
            WHEN 'K'. mth = '11'.
            WHEN 'L'. mth = '12'.
          ENDCASE.

          CLEAR yer.
          yer = ls_dtl-dtcode+3(2).

          CLEAR lv_date.
          CONCATENATE ls_dtl-dtcode+0(2) mth yer INTO lv_date.
          CALL FUNCTION 'CONVERT_DATE_TO_INTERNAL'
            EXPORTING
              date_external            = lv_date
            IMPORTING
              date_internal            = lv_date
            EXCEPTIONS
              date_external_is_invalid = 1.
          IF lv_date IS NOT INITIAL.  "added Avinash : 19.12.2024 : ECDK932068
            ls_dtl-sdate = lv_date.
          ELSE.
            ls_dtl-sdate = sy-datum. "added Avinash : 19.12.2024 : ECDK932068
          ENDIF.
          ls_dtl-mjahr = ls_dtl-sdate+0(4).
          ls_dtl-kdmat  = str1.
          ls_dtl-vndrcd = str4.
          ls_dtl-vndrcd = |{ ls_dtl-vndrcd ALPHA = IN }|.
          es_entity = CORRESPONDING #( ls_dtl ).
          TRANSLATE es_entity-kdmat TO UPPER CASE.  "added Avinash : 19.12.2024 : ECDK932068
          IF lv_date IS NOT INITIAL.
            es_entity-date = lv_date.
          ELSE.
            es_entity-date = sy-datum.
          ENDIF.
          es_entity-year =  ls_dtl-sdate+0(4).
          es_entity-serial = str2.
          TRANSLATE ls_dtl-kdmat TO UPPER CASE.


          IF ls_dtl-kdmat NE ls_hdr-kdmat.
            CALL METHOD lo_container->add_message
              EXPORTING
                iv_msg_type               = /iwbep/cl_cos_logger=>error
                iv_msg_id                 = '00'
                iv_msg_number             = '000'
                iv_msg_text               = 'Part number not match..'
                iv_add_to_response_header = abap_true.
            copy_data_to_ref( EXPORTING is_data = ls_data_deep
                              CHANGING  cr_data = er_deep_entity ).
            EXIT.
          ELSE.
            SELECT SINGLE * FROM zsd_cust_fg_st INTO @DATA(ls_st)
             WHERE werks = @ls_dtl-werks
             AND   matnr = @ls_dtl-matnr
             AND  ( mjahr = @ls_dtl-mjahr OR  mjahr = '0000' )
             AND   srnos = @ls_dtl-srnos
             AND  ( sdate = @ls_dtl-sdate OR sdate = '00000000' )
             AND   kunnr = @ls_dtl-kunnr.

            IF sy-subrc = 0.
              CALL METHOD lo_container->add_message
                EXPORTING
                  iv_msg_type               = /iwbep/cl_cos_logger=>error
                  iv_msg_id                 = '00'
                  iv_msg_number             = '000'
                  iv_msg_text               = 'Part number already scanned...'
                  iv_add_to_response_header = abap_true.
