                TABLES
                  headerdeadline = lt_headerdeadline
                  itemdata       = lt_itemdata
*                 STAGEDATA      =
*                 STAGEDEADLINE  =
*                 itemonstage    = lt_itemonstage
*                 ADDRESS        =
*                 HDUNHEADER     =
*                 HDUNITEM       =
                  return         = lt_return.

*              COMMIT WORK AND WAIT.

              CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
                EXPORTING
                  wait = 'X'
*        IMPORTING
*                 RETURN        =
                .

              WAIT UP TO 1 SECONDS.




              DELETE messtab WHERE msgtyp = 'S'.
              DELETE messtab WHERE msgtyp = 'W'.

              DATA flag(1) TYPE c.
              IF messtab[] IS INITIAL.
                LOOP AT lt_dtl INTO ls_dtl1.
                  SELECT SINGLE vbeln FROM vbfa INTO @DATA(ls_shipno)
                    WHERE vbelv = @ls_dtl1-vbeln
                    AND   vbtyp_n = '8'.
                  IF sy-subrc = 0.
                    flag = 'X'.
                    SELECT SINGLE vbeln FROM vbfa INTO @DATA(ls_vbeln)
                      WHERE vbelv = @ls_dtl1-vbeln
                      AND   vbtyp_n = 'M'.
                    IF sy-subrc = 0.
                    ELSE.

                      CALL METHOD lo_container->add_message
                        EXPORTING
                          iv_msg_type               = /iwbep/cl_cos_logger=>error
                          iv_msg_id                 = '00'
                          iv_msg_number             = '000'
                          iv_msg_text               = 'Error in Billing docment creation'
                          iv_add_to_response_header = abap_true.

                      copy_data_to_ref( EXPORTING is_data = ls_billdata
                                        CHANGING  cr_data = er_deep_entity ).

                    ENDIF.
                  ELSE.

                    CALL METHOD lo_container->add_message
                      EXPORTING
                        iv_msg_type               = /iwbep/cl_cos_logger=>error
                        iv_msg_id                 = '00'
                        iv_msg_number             = '000'
                        iv_msg_text               = 'Error in shipment creation'
                        iv_add_to_response_header = abap_true.

                    copy_data_to_ref( EXPORTING is_data = ls_billdata
                                      CHANGING  cr_data = er_deep_entity ).
                  ENDIF.


                  IF flag = 'X'.

                    LOOP AT gt_st INTO ls_st2 WHERE flag = 'X' AND vbeln = ls_dtl1-vbeln.

                      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
                        EXPORTING
                          input  = ls_st2-matnr
                        IMPORTING
                          output = ls_st2-matnr.

                      UPDATE zsd_cust_fg_st SET vbeln = ls_st2-vbeln
                                                lfdat = sy-datum
                                                vbelv = ls_vbeln
                                            WHERE werks = ls_st2-werks
                                            AND   matnr = ls_st2-matnr
                                            AND   labno = ls_st2-labno
                                            AND   kunnr = ls_st2-kunnr.
                      CLEAR ls_st2.
                    ENDLOOP.
                    LOOP AT gt_st7 INTO ls_st2 WHERE vbeln = ls_dtl1-vbeln..
                      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
                        EXPORTING
                          input  = ls_st2-matnr
                        IMPORTING
                          output = ls_st2-matnr.
                      UPDATE zsd_cust_fg_st SET vbeln = ls_st2-vbeln
                                                lfdat = sy-datum
                                                vbelv = ls_vbeln
                                            WHERE werks = ls_st2-werks
                                            AND   matnr = ls_st2-matnr
                                            AND   labno = ls_st2-labno
                                            AND kunnr = ls_st2-kunnr..
                      CLEAR ls_st2.
                    ENDLOOP.


                    CONCATENATE 'Billing document created...' ls_vbeln INTO lv_msg.


                    CALL METHOD lo_container->add_message
                      EXPORTING
                        iv_msg_type               = /iwbep/cl_cos_logger=>success
                        iv_msg_id                 = '00'
                        iv_msg_number             = '000'
                        iv_msg_text               = lv_msg
                        iv_add_to_response_header = abap_true.

                    copy_data_to_ref( EXPORTING is_data = ls_billdata
                                      CHANGING  cr_data = er_deep_entity ).

                  ENDIF.
                  CLEAR ls_dtl.
                  CLEAR : ls_shipno, ls_vbeln.
                ENDLOOP.

              ENDIF.
            ENDIF.
          ELSEIF lwa_items-pstyv = ' '.
            LOOP AT gt_st INTO ls_st2 WHERE flag = 'X'.

              CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
                EXPORTING
                  input  = ls_st2-matnr
                IMPORTING
                  output = ls_st2-matnr.

              UPDATE zsd_cust_fg_st SET vbeln = ls_st2-vbeln
                                    WHERE werks = ls_st2-werks
                                    AND   matnr = ls_st2-matnr
                                    AND   kunnr = ls_st2-kunnr
                                    AND   labno = ls_st2-labno.
              CLEAR ls_st.
            ENDLOOP.
            CALL METHOD lo_container->add_message
              EXPORTING
                iv_msg_type               = /iwbep/cl_cos_logger=>success
                iv_msg_id                 = '00'
                iv_msg_number             = '000'
                iv_msg_text               = 'Data Park succefully'
                iv_add_to_response_header = abap_true.

            copy_data_to_ref( EXPORTING is_data = ls_billdata
                              CHANGING  cr_data = er_deep_entity ).
          ENDIF.
        ENDIF.

        READ TABLE ls_billdata-item INTO lwa_item INDEX 1.
        IF sy-subrc EQ 0.
          lwa_item-vbelv = lv_billdoc.
          MODIFY ls_billdata-item FROM lwa_item INDEX 1
          TRANSPORTING vbelv .
        ENDIF.

        CALL METHOD me->copy_data_to_ref
          EXPORTING
            is_data = ls_billdata
          CHANGING
            cr_data = er_deep_entity.
      ENDIF.
    ENDIF.
  ENDMETHOD.


  method /IWBEP/IF_MGW_APPL_SRV_RUNTIME~GET_STREAM.

    DATA(it_keys) = io_tech_request_context->get_keys( ).
    DATA(lv_key) = VALUE #( it_keys[ 1 ]-value OPTIONAL ).
    DATA :
      lv_fm_name            TYPE rs38l_fnam,
      lv_labno              TYPE zlabno,
      lv_matnr              TYPE matnr,
      lv_kunnr              TYPE kunnr,
      lv_pkgno              TYPE zpkgno,
      lv_kdmat              TYPE kdmat,
      ls_output_options     TYPE ssfcompop,
      lv_language           TYPE tdspras,
      ls_control_parameters TYPE ssfctrlop,
      ls_output_data        TYPE ssfcrescl,
      lv_pdf_len            TYPE i,
      lv_pdf_xstring        TYPE xstring,
      lt_lines              TYPE TABLE OF tline,
      lv_devtype            TYPE rspoptype,
      lv_app_type           TYPE string,
      lv_guid               TYPE guid_32,
      lo_cached_response    TYPE REF TO if_http_response,
      lt_tstotf             TYPE tsfotf,
      ls_job_output_info TYPE ssfcrescl.

    READ TABLE it_keys WITH KEY name = 'LABNO' INTO DATA(ls_key).
    lv_labno = ls_key-value.
    READ TABLE it_keys WITH KEY name = 'MATNR' INTO DATA(ls_key1).
    lv_matnr = ls_key1-value.
    READ TABLE it_keys WITH KEY name = 'PKGNO' INTO DATA(ls_key2).
    lv_pkgno = ls_key2-value.
    READ TABLE it_keys WITH KEY name = 'KDMAT' INTO DATA(ls_key3).
    lv_kdmat = ls_key3-value.
    READ TABLE it_keys WITH KEY name = 'KUNNR' INTO DATA(ls_key4).
    lv_kunnr = ls_key4-value.

    IF lv_key IS NOT INITIAL.

* language
      lv_language = sy-langu.

      TRANSLATE lv_language TO UPPER CASE.
      ls_control_parameters-langu = lv_language.

* set control parameters to get the output text format (OTF) from Smart Forms
      ls_control_parameters-no_dialog = abap_true.
      ls_control_parameters-getotf    = abap_true.
      ls_control_parameters-preview = space. "No preview


* get device type from language
      CALL FUNCTION 'SSF_GET_DEVICE_TYPE'
        EXPORTING
          i_language             = lv_language
*         i_application          = 'SAPDEFAULT'
        IMPORTING
          e_devtype              = lv_devtype
        EXCEPTIONS
          no_language            = 1
          language_not_installed = 2
          no_devtype_found       = 3
          system_error           = 4
          OTHERS                 = 5.

* set device type in output options
      ls_output_options-tdprinter = lv_devtype.
* Set relevant output options
      ls_output_options-tdnewid  = 'X'. "Print parameters,
      ls_output_options-tddelete = space. "Print parameters
      ls_output_options-tddest = 'LP01'.

      CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
        EXPORTING
*          formname           = 'ZSD_CUST_LABEL_FORM'  "Smartform name
          formname           = 'ZSD_CUST_LABEL_FORM_FIORI'  "Smartform name
        IMPORTING
          fm_name            = lv_fm_name
        EXCEPTIONS
          no_form            = 1
          no_function_module = 2
          OTHERS             = 3.


      CALL FUNCTION lv_fm_name
        EXPORTING
          control_parameters = ls_control_parameters
          output_options     = ls_output_options
          user_settings      = space
          e_matnr            = lv_matnr
          e_kdmat            = lv_kdmat
          e_kunnr            = lv_kunnr
          e_pkgno            = lv_pkgno
          e_labno            = lv_labno
 IMPORTING

         JOB_OUTPUT_INFO    = ls_job_output_info

        EXCEPTIONS
          formatting_error   = 1
          internal_error     = 2
          send_error         = 3
          user_canceled      = 4
          OTHERS             = 5.

      APPEND LINES OF ls_job_output_info-otfdata[] TO lt_tstotf[].

* convert to otf
      CALL FUNCTION 'CONVERT_OTF'
        EXPORTING
          format                = 'PDF'
        IMPORTING
          bin_filesize          = lv_pdf_len
          bin_file              = lv_pdf_xstring       " binary file
        TABLES
          otf                   = lt_tstotf
          lines                 = lt_lines
        EXCEPTIONS
          err_max_linewidth     = 1
          err_format            = 2
          err_conv_not_possible = 3
          err_bad_otf           = 4
          OTHERS                = 5.
      IF sy-subrc <> 0.
*   error handling

      ENDIF.

      DATA(ls_s_media_resource) = VALUE ty_s_media_resource( mime_type = 'application/pdf'
                                                             value     = lv_pdf_xstring ).

      copy_data_to_ref(
        EXPORTING
          is_data = ls_s_media_resource
        CHANGING
          cr_data = er_stream
      ).
    ENDIF.


 endmethod.


