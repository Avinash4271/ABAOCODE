              vgbel TYPE lips-vgbel,
              vgpos TYPE lips-vgpos,
              vtweg TYPE lips-vtweg,
              spart TYPE lips-spart,
              vstel TYPE likp-vstel,
              lgort TYPE lips-lgort,      " Avinash : 26.09.2025 : ECDK933195
            END OF gty_lips.

    TYPES : BEGIN OF gty_dtl.
              INCLUDE TYPE gty_lips.
    TYPES :   maktx TYPE makt-maktx,
              pkgno TYPE lips-lfimg,
              mark  TYPE boolean,
            END OF gty_dtl.

    TYPES : BEGIN OF gty_st,
              werks   TYPE zsd_cust_fg_st-werks,
              matnr   TYPE zsd_cust_fg_st-matnr,
              kunnr   TYPE kunnr,
*              kdmat   TYPE zsd_cust_fg_st-kdmat,
              pkgno   TYPE zsd_cust_fg_st-pkgno,
              labno   TYPE zsd_cust_fg_st-labno,
              flag(1) TYPE c,
              vbeln   TYPE lips-vbeln,
              posnr   TYPE lips-posnr,

            END OF gty_st.

    DATA : gt_lips TYPE STANDARD TABLE OF gty_lips,
           gt_dtl  TYPE STANDARD TABLE OF gty_dtl.

    DATA : gt_st  TYPE STANDARD TABLE OF gty_st,
           gt_st7 TYPE STANDARD TABLE OF gty_st.
*- Work area declaration
    DATA : gw_dtl TYPE gty_dtl.

    DATA: wa_key                   TYPE /iwbep/s_mgw_name_value_pair,
          ls_filter_select_options TYPE /iwbep/s_mgw_select_option,
          ls_select_option         TYPE /iwbep/s_cod_select_option,
          lt_select_options        TYPE /iwbep/t_cod_select_options,
          es_entity                LIKE LINE OF et_entityset.

    TYPES: ty_rng_vkorg TYPE RANGE OF vkorg,
           ty_rng_vbeln TYPE RANGE OF vbeln,
           ty_rng_werks TYPE RANGE OF werks,
           ty_rng_lifnr TYPE RANGE OF lifnr,
           ty_rng_vehno TYPE RANGE OF exti1.

    DATA:
      rng_vkorg    TYPE ty_rng_vkorg,
      wa_rng_vkorg TYPE LINE OF ty_rng_vkorg,

      rng_vbeln    TYPE ty_rng_vbeln,
      wa_rng_vbeln TYPE LINE OF ty_rng_vbeln,

      rng_werks    TYPE ty_rng_werks,
      wa_rng_werks TYPE LINE OF ty_rng_werks,

      rng_lifnr    TYPE ty_rng_lifnr,
      wa_rng_lifnr TYPE LINE OF ty_rng_lifnr,

      rng_vehno    TYPE ty_rng_vehno,
      wa_rng_vehno TYPE LINE OF ty_rng_vehno.

    DATA: lo_message_container
             TYPE REF TO /iwbep/if_message_container.

    DATA: p_werks  TYPE werks_d,
          p_vkorg  TYPE vkorg,
          p_vbeln  TYPE likp-vbeln,
          p_lifnr  TYPE lfa1-lifnr,
          p_vehno  TYPE vttk-exti1,
          lv_vbeln TYPE vbeln.

    DATA : gv_ewh(1) TYPE c.    " nrp : 26.09.2025
    DATA: r1 TYPE c,
          r2 TYPE c.
    DATA gv_vstel TYPE likp-vstel.
    p_vkorg = '1100'. " remove hardconding by passing from frontend

    lo_message_container = me->mo_context->get_message_container( ).
* Validate Sales organization
    READ TABLE it_filter_select_options INTO ls_filter_select_options WITH KEY property = 'VKORG'.
    IF ls_filter_select_options-property IS NOT INITIAL.
      lt_select_options[] =  ls_filter_select_options-select_options[].

      LOOP AT lt_select_options INTO ls_select_option.

        wa_rng_vkorg-sign = ls_select_option-sign.
        wa_rng_vkorg-option = ls_select_option-option.
        wa_rng_vkorg-low = ls_select_option-low.
        wa_rng_vkorg-high = ls_select_option-high.
        APPEND wa_rng_vkorg TO rng_vkorg.

        p_vkorg = wa_rng_vkorg-low.
        SELECT SINGLE vkorg FROM tvko INTO @DATA(ls_vkorg)
    WHERE vkorg = @p_vkorg.
        IF sy-subrc NE 0.

          CALL METHOD lo_message_container->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Invalid Sales Organisation....'
              iv_add_to_response_header = abap_true.
          DATA(flag) = 'X'.
        ENDIF.
        CLEAR: ls_select_option, wa_rng_vbeln.
      ENDLOOP.
    ENDIF.



* Validate plant
    READ TABLE it_filter_select_options INTO ls_filter_select_options WITH KEY property = 'WERKS'.
    IF ls_filter_select_options-property IS NOT INITIAL.
      lt_select_options[] =  ls_filter_select_options-select_options[].

      LOOP AT lt_select_options INTO ls_select_option.

        wa_rng_werks-sign = ls_select_option-sign.
        wa_rng_werks-option = ls_select_option-option.
        wa_rng_werks-low = ls_select_option-low.
        wa_rng_werks-high = ls_select_option-high.
        APPEND wa_rng_werks TO rng_werks.

        p_werks = wa_rng_werks-low.

        SELECT SINGLE 'X' FROM tvarvc INTO @gv_ewh
        WHERE name = 'S_EWH_PLANT'
        AND   low  = @p_werks.                        "added by Avinash : 26.09.2025 : ECDK933195

        SELECT SINGLE werks
                 FROM t001w
                 INTO @DATA(ls_werks)
                WHERE werks EQ @p_werks
                  AND vkorg EQ @p_vkorg.
        IF sy-subrc NE 0.

          CALL METHOD lo_message_container->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Invalid plant code selected.....'
              iv_add_to_response_header = abap_true.
          flag = 'X'.
        ENDIF.

        CLEAR: ls_select_option, wa_rng_werks.
      ENDLOOP.
    ENDIF.

    DATA : lt_numbers TYPE TABLE OF string.
    READ TABLE it_filter_select_options INTO ls_filter_select_options WITH KEY property = 'VBELN'.
    IF ls_filter_select_options-property IS NOT INITIAL.
      lt_select_options[] =  ls_filter_select_options-select_options[].
      DELETE lt_select_options[] WHERE low = ''.
      DESCRIBE TABLE lt_select_options[] LINES DATA(lv_lines).
      DATA(ls_number) = lt_select_options[ 1 ].

      IF ls_number-low CA ','.
       clear lt_select_options[].
        SPLIT ls_number-low AT ',' INTO TABLE lt_numbers.
        LOOP AT lt_numbers INTO DATA(ls_num).
          APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_num
          ) TO lt_select_options.
        ENDLOOP.
      ENDIF.
      LOOP AT lt_select_options INTO ls_select_option.

        wa_rng_vbeln-sign = ls_select_option-sign.
        wa_rng_vbeln-option = ls_select_option-option.
        lv_vbeln = ls_select_option-low.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = lv_vbeln
          IMPORTING
            output = lv_vbeln.
        wa_rng_vbeln-low = lv_vbeln.
        p_vbeln = ls_select_option-low.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = p_vbeln
          IMPORTING
            output = p_vbeln.
        IF lv_lines GT 1. "added by avinash
          READ TABLE lt_select_options INTO ls_select_option  INDEX lv_lines.
          IF sy-subrc = 0.
            lv_vbeln = ls_select_option-low.
            wa_rng_vbeln-option = 'BT'.
            CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
              EXPORTING
                input  = lv_vbeln
              IMPORTING
                output = lv_vbeln.
            wa_rng_vbeln-high = lv_vbeln.
          ENDIF.
        ENDIF.
        APPEND wa_rng_vbeln TO rng_vbeln.
        CLEAR: ls_select_option, wa_rng_vbeln.
      ENDLOOP.
    ENDIF.
    DELETE rng_vbeln WHERE low = ''.
    READ TABLE it_filter_select_options INTO ls_filter_select_options WITH KEY property = 'FLAG'.
    IF ls_filter_select_options-property IS NOT INITIAL.
      lt_select_options[] =  ls_filter_select_options-select_options[].

      LOOP AT lt_select_options INTO ls_select_option.
        IF ls_select_option-low = '0'.
          r1 = 'X'.
        ELSEIF ls_select_option-low = '1'.
          r2 = 'X'.
        ENDIF.
        CLEAR: ls_select_option.
      ENDLOOP.
    ENDIF.
    IF r1 = 'X'.
      SELECT SINGLE vbeln
               FROM lips
               INTO @DATA(l_vbeln)
              WHERE vbeln = @p_vbeln
              AND   werks = @p_werks.
      IF sy-subrc NE 0.
        .

        CALL METHOD lo_message_container->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Plant and document not matching.'
            iv_add_to_response_header = abap_true.
        flag = 'X'.
        EXIT.

      ENDIF.

      SELECT SINGLE vbeln FROM vbfa INTO @DATA(lv_billdoc)
  WHERE vbelv = @p_vbeln
  AND   vbtyp_n = 'M'.
      IF NOT lv_billdoc IS INITIAL.

        CALL METHOD lo_message_container->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Billing document created against Delivery....'
            iv_add_to_response_header = abap_true.
        flag = 'X'.
        EXIT.
      ENDIF.

    ELSEIF r2 = 'X'.
* Validation of delivery against VBFA table
      SELECT vbeln
        FROM likp
        INTO TABLE @DATA(lt_likp)
       WHERE vbeln IN @rng_vbeln.
      LOOP AT lt_likp INTO DATA(ls_likp).
        SELECT SINGLE vbeln FROM vbfa INTO @DATA(lv_shipno)
          WHERE vbelv = @ls_likp-vbeln
          AND   vbtyp_n = '8'.
        IF NOT lv_shipno IS INITIAL.
          CALL METHOD lo_message_container->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Shipment already created against Delivery....'
              iv_add_to_response_header = abap_true.
          flag = 'X'.
          EXIT.
        ELSE.
          CLEAR lv_billdoc.
          SELECT SINGLE vbeln FROM vbfa INTO lv_billdoc
            WHERE vbelv = ls_likp-vbeln
            AND   vbtyp_n = 'M'.
          IF NOT lv_billdoc IS INITIAL.
            CALL METHOD lo_message_container->add_message
              EXPORTING
                iv_msg_type               = /iwbep/cl_cos_logger=>error
                iv_msg_id                 = '00'
                iv_msg_number             = '000'
                iv_msg_text               = 'Billing document created against Delivery....'
                iv_add_to_response_header = abap_true.
            flag = 'X'.
            EXIT.
          ENDIF.
        ENDIF.
        CLEAR ls_likp.
      ENDLOOP.

      READ TABLE it_filter_select_options INTO ls_filter_select_options WITH KEY property = 'LIFNR'.
      IF ls_filter_select_options-property IS NOT INITIAL.
        lt_select_options[] =  ls_filter_select_options-select_options[].

        LOOP AT lt_select_options INTO ls_select_option.

          wa_rng_lifnr-sign = ls_select_option-sign.
          wa_rng_lifnr-option = ls_select_option-option.
          wa_rng_lifnr-low = ls_select_option-low.
          p_lifnr = ls_select_option-low.
          wa_rng_lifnr-high = ls_select_option-high.
          APPEND wa_rng_lifnr TO rng_lifnr.
          CLEAR: ls_select_option, wa_rng_lifnr.
        ENDLOOP.
        p_lifnr = |{ p_lifnr ALPHA = IN }|.
        IF p_lifnr IS NOT INITIAL.

          SELECT SINGLE *
                 FROM lfa1
                 INTO @DATA(ls_lfa1)
                 WHERE lifnr = @p_lifnr
                 AND ktokk = 'Z005'.          "#EC CI_ALL_FIELDS_NEEDED
          IF sy-subrc NE 0.

            CALL METHOD lo_message_container->add_message
              EXPORTING
                iv_msg_type               = /iwbep/cl_cos_logger=>error
                iv_msg_id                 = '00'
                iv_msg_number             = '000'
                iv_msg_text               = 'Invalid transporter selected.....'
                iv_add_to_response_header = abap_true.
            flag = 'X'.
            EXIT.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

    SELECT a~vbeln a~posnr a~matnr a~werks a~kdmat b~kunag a~lfimg
