    ENDIF.
    IF line_exists( it_filter_select_options[ property = |LABNO| ] ).
      lv_labno = it_filter_select_options[ property = |LABNO| ]-select_options[ 1 ]-low.
    ENDIF.
    lo_cotainer = me->mo_context->get_message_container( ).
    lv_kunnr = |{ lv_kunnr ALPHA = IN }|.

   IF lv_werks IS NOT INITIAL.
      SELECT SINGLE * FROM t001w INTO @DATA(ls_plant)
       WHERE werks = @lv_werks.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Please Enter valid plant..'
            iv_add_to_response_header = abap_true.
        EXIT.
      ENDIF.
    ENDIF.
    IF lv_matnr IS NOT INITIAL.
      SELECT SINGLE matnr FROM marc INTO @DATA(ls_matnr)
     WHERE matnr = @lv_matnr
     AND   werks = @lv_werks.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Material not found in plant..'
            iv_add_to_response_header = abap_true.
        EXIT.
      ENDIF.
    ENDIF.
    IF lv_kunnr IS NOT INITIAL.
      SELECT SINGLE name1 FROM kna1 INTO @DATA(ls_kunnr)
      WHERE kunnr = @lv_kunnr.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'customer not found..'
            iv_add_to_response_header = abap_true.
        EXIT.
      ENDIF.
    ENDIF.
    IF lv_labno IS  INITIAL.
      SELECT SINGLE * FROM zsd_cust_fg_pk
        WHERE werks = @lv_werks
        AND matnr = @lv_matnr
        AND kunnr = @lv_kunnr
        INTO @DATA(gs_pack).


      IF sy-subrc NE 0.


        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Please maintain Packaging details..'
            iv_add_to_response_header = abap_true.
        EXIT.

      ELSE.
        IF gs_pack-pkgno IS INITIAL.
          CALL METHOD lo_cotainer->add_message
            EXPORTING
              iv_msg_type               = /iwbep/cl_cos_logger=>error
              iv_msg_id                 = '00'
              iv_msg_number             = '000'
              iv_msg_text               = 'Please maintain Number of Packaging ...'
              iv_add_to_response_header = abap_true.
          EXIT.
        ENDIF.
        es_entityset  = CORRESPONDING #( gs_pack ).
        APPEND es_entityset TO et_entityset.
      ENDIF.
    ELSE.
      SELECT SINGLE * FROM zsd_cust_fg_pk
  WHERE werks = @lv_werks
  AND matnr = @lv_matnr
  AND kunnr = @lv_kunnr
  INTO @DATA(gs_pack1).
      SELECT * FROM zsd_cust_fg_st INTO TABLE @DATA(lt_pack)
        WHERE werks = @lv_werks
        AND   matnr = @lv_matnr
        AND   kunnr = @lv_kunnr
        AND   labno = @lv_labno.
      IF sy-subrc NE 0.
        CALL METHOD lo_cotainer->add_message
          EXPORTING
            iv_msg_type               = /iwbep/cl_cos_logger=>error
            iv_msg_id                 = '00'
            iv_msg_number             = '000'
            iv_msg_text               = 'Data not found for selection ...'
            iv_add_to_response_header = abap_true.
        EXIT.
      ENDIF.
      DESCRIBE TABLE lt_pack LINES DATA(lv_lines).
      LOOP AT lt_pack INTO DATA(ls_pack).
        es_entityset = CORRESPONDING #( ls_pack ).
        es_entityset-no    = lv_lines.
        es_entityset-pkgno = gs_pack1-pkgno.
        es_entityset-maktx =  gs_pack1-maktx.
        es_entityset-year  = ls_pack-mjahr.
        es_entityset-date  = ls_pack-sdate.
        es_entityset-serial = ls_pack-srnos.
        APPEND es_entityset TO et_entityset.

      ENDLOOP.

    ENDIF.
