              IF sy-subrc = 0.

                CALL METHOD lo_container->add_message
                  EXPORTING
                    iv_msg_type               = /iwbep/cl_cos_logger=>error
                    iv_msg_id                 = '00'
                    iv_msg_number             = '000'
                    iv_msg_text               = 'Part number already scanned..pl check below data.'
                    iv_add_to_response_header = abap_true.

                copy_data_to_ref( EXPORTING is_data = ls_data_deep
                                  CHANGING  cr_data = er_deep_entity ).
                EXIT.
              ELSE.
                DESCRIBE TABLE ls_data_deep-scan LINES DATA(lv_lines).
                ls_data_deep-no = lv_lines + 1.
                APPEND es_entity TO ls_data_deep-scan .
                DELETE ls_data_deep-scan WHERE kdmat = ''.
                copy_data_to_ref( EXPORTING is_data = ls_data_deep
                                  CHANGING  cr_data = er_deep_entity ).
              ENDIF.
            ENDIF.
          ENDIF.

          copy_data_to_ref( EXPORTING is_data = ls_data_deep
                            CHANGING  cr_data = er_deep_entity ).
        ELSE.
          copy_data_to_ref( EXPORTING is_data = ls_data_deep
                            CHANGING  cr_data = er_deep_entity ).

        ENDIF.
*    APPEND es_entity TO ls_data_deep-scan .
        copy_data_to_ref( EXPORTING is_data = ls_data_deep
